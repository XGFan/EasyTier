# fork/mini.env — settings for the dedicated macOS test box ("mini").
# Copy to fork/mini.env (gitignored) and fill in. Read by fork/mini.sh.

# ssh host alias for the test box, reachable over the direct cable link
MINI_SSH=mini
# install root on the test box (created and chowned to the ssh user on first deploy)
MINI_DIR=/usr/local/easytier-test

# where to copy network_name / network_secret from (this machine's own config)
ET_DEV_CONFIG="$HOME/Library/Application Support/EasyTier/config.toml"
# peers the test box dials (space separated); usually the same public relay as this machine
ET_PEERS="tcp://relay.example.net:11010 udp://relay.example.net:11010"

# identity of the test box inside the easytier network
ET_MINI_HOSTNAME=mini
ET_MINI_IPV4=10.0.0.20
# exit node the full tunnel goes through
ET_EXIT_NODE=10.0.0.2

# gate parameters (see fork/verify-fulltunnel.sh)
ET_PING_TARGET=192.0.2.1        # a host that exists only behind the exit node
ET_PING_MAX_MS=120              # on the MINIMUM rtt: direct ~25ms, relayed 180ms+; cellular jitter is ignored
ET_EGRESS_CN_URL=https://ipv4.ddnspod.com # domestic IPv4 echo, reachable from both sides
ET_EGRESS_INTL_URL=https://api.ipify.org  # foreign IPv4 echo, only reachable through the tunnel
